{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs" },
    { "source": "/admin", "destination": "/api/index.mjs" },
    { "source": "/login", "destination": "/api/index.mjs" },
    { "source": "/event/:id", "destination": "/api/index.mjs" },
    { "source": "/view/:id", "destination": "/api/index.mjs" },
    { "source": "/register/:id", "destination": "/api/index.mjs" },
    { "source": "/(.*)", "destination": "/api/index.mjs" }
  ]
}
